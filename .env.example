# Variáveis do container. Nenhuma delas é um segredo do SERPRO: consumer key,
# consumer secret e senha do certificado ficam no Supabase Vault, e o .pfx no
# bucket privado. O que entra aqui é só o endereço e a chave para alcançá-los.

# Postgres do portal, com service role (precisa ler vault.decrypted_secrets).
DATABASE_URL=postgresql://postgres:SENHA@db.ulwnlbaeriqaiiqvclsl.supabase.co:5432/postgres

# Storage: baixar o .pfx de `certificados-on` e gravar PDF em `integra`.
SUPABASE_URL=https://ulwnlbaeriqaiiqvclsl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Opcionais
LOG_LEVEL=INFO
INTERVALO_OCIOSO_S=5
